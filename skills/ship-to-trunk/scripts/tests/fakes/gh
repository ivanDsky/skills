#!/usr/bin/env python3
"""Offline `gh` stand-in for the ship-to-trunk script tests.

State lives in $GH_FAKE_DIR/state.json (written by the test):
  runs   list of `gh run list` objects (newest first)
  prs    {"<number>": {... `gh pr view --json` object ...}}
  merge  "ok" | "checkout_error" (merges, then fails like gh does when main is
         checked out in another worktree) | "checkout_error_open" (fails with
         the same message but the PR stays OPEN) | "refused"
  create_url   URL printed by `gh pr create` (the PR is registered OPEN)
  land   true: a merge also pushes the --match-head-commit sha to origin's main
         (the squash of a linear branch), then runs the executable
         $GH_FAKE_DIR/after_merge when the test wrote one (main moves under the lane)
Every call is appended to $GH_FAKE_DIR/calls.log as one JSON argv line.
"""
import json
import os
import subprocess
import sys

d = os.environ["GH_FAKE_DIR"]
state_path = os.path.join(d, "state.json")
state = json.load(open(state_path))
args = sys.argv[1:]
with open(os.path.join(d, "calls.log"), "a") as f:
    f.write(json.dumps(args) + "\n")


def save():
    json.dump(state, open(state_path, "w"))


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def project(obj, fields):
    return {k: obj.get(k) for k in fields.split(",")}


def find_pr(ref):
    prs = state["prs"]
    if ref in prs:
        return prs[ref]
    return next((p for p in prs.values() if p.get("headRefName") == ref), None)


if args[:2] == ["run", "list"]:
    runs = state["runs"]
    want = opt("--status")
    if want:
        runs = [r for r in runs if want in (r["status"], r["conclusion"])]
    wf = opt("--workflow")
    assert wf, "run list without --workflow"
    print(json.dumps([project(r, opt("--json")) for r in runs[: int(opt("-L", "20"))]]))
elif args[:2] == ["run", "watch"]:
    sys.exit(0)
elif args[:2] == ["pr", "view"]:
    pr = find_pr(args[2])
    if pr is None:
        print("no pull requests found", file=sys.stderr)
        sys.exit(1)
    if opt("-q") == ".state":
        print(pr["state"])
    else:
        print(json.dumps(project(pr, opt("--json"))))
elif args[:2] == ["pr", "create"]:
    url = state["create_url"]
    number = url.rsplit("/", 1)[-1]
    state["prs"][number] = {"number": int(number), "url": url, "state": "OPEN", "mergedAt": None,
                            "headRefName": state.get("create_branch")}
    save()
    print(url)
elif args[:2] == ["pr", "merge"]:
    mode = state.get("merge", "ok")
    pr = state["prs"][args[2]]
    if mode == "refused":
        print("Pull request is not mergeable", file=sys.stderr)
        sys.exit(1)
    if mode != "checkout_error_open":
        pr["state"] = "MERGED"
        save()
        if state.get("land"):
            subprocess.run(["git", "push", "-q", "origin", opt("--match-head-commit") + ":refs/heads/main"], check=True)
            hook = os.path.join(d, "after_merge")
            if os.access(hook, os.X_OK):
                subprocess.run([hook], check=True)
    if mode.startswith("checkout_error"):
        print("failed to run git: fatal: 'main' is already checked out at '/somewhere/main'", file=sys.stderr)
        sys.exit(1)
else:
    print("gh fake: unsupported " + " ".join(args), file=sys.stderr)
    sys.exit(2)
