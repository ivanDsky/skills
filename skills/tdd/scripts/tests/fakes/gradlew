#!/bin/sh
# Stand-in for ./gradlew. Invocation n (1-based) replays $FLAKE_FAKE_DIR/plan/<n>/:
#   *.xml  copied to $FLAKE_FAKE_MODULE_DIR/build/test-results/$FLAKE_FAKE_TASK/
#   log    printed to stdout (Gradle console output)
#   rc     exit code (default 0)
# Every invocation's arguments are appended to $FLAKE_FAKE_DIR/args.log.
d="$FLAKE_FAKE_DIR"
n=$(( $(cat "$d/count" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$d/count"
echo "$*" >> "$d/args.log"
plan="$d/plan/$n"
out="$FLAKE_FAKE_MODULE_DIR/build/test-results/$FLAKE_FAKE_TASK"
if ls "$plan"/*.xml >/dev/null 2>&1; then
  mkdir -p "$out"
  cp "$plan"/*.xml "$out"/
fi
[ -f "$plan/log" ] && cat "$plan/log"
exit "$(cat "$plan/rc" 2>/dev/null || echo 0)"
